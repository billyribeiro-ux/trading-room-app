{
  "components": {
    "responses": {
      "BadRequest": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Invalid request."
      },
      "Forbidden": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "The exact browser origin was not accepted."
      },
      "NotFound": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "The resource does not exist or is outside the caller's authority."
      },
      "RateLimited": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "The request budget is exhausted."
      },
      "Unauthorized": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Authentication is absent, expired, or invalid."
      },
      "Unavailable": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "A required dependency is unavailable."
      }
    },
    "schemas": {
      "Account": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/AccountRole"
          },
          "rooms": {
            "items": {
              "$ref": "#/components/schemas/AccountRoom"
            },
            "type": "array"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "role",
          "rooms"
        ],
        "type": "object"
      },
      "AccountBootstrap": {
        "additionalProperties": false,
        "properties": {
          "accounts": {
            "items": {
              "$ref": "#/components/schemas/Account"
            },
            "type": "array"
          },
          "user": {
            "$ref": "#/components/schemas/CurrentUser"
          }
        },
        "required": [
          "user",
          "accounts"
        ],
        "type": "object"
      },
      "AccountRole": {
        "enum": [
          "owner",
          "admin"
        ],
        "type": "string"
      },
      "AccountRoom": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "memberId": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "owner",
              "presenter",
              "limited_presenter",
              "moderator",
              "member"
            ],
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "state",
          "memberId",
          "role"
        ],
        "type": "object"
      },
      "ArchiveAccountRoomRequest": {
        "additionalProperties": false,
        "properties": {
          "archived": {
            "type": "boolean"
          }
        },
        "required": [
          "archived"
        ],
        "type": "object"
      },
      "CreateAccountRoomRequest": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "After trimming, the UTF-8 encoding must contain at most 160 bytes.",
            "maxLength": 160,
            "minLength": 1,
            "type": "string",
            "x-maxBytes": 160
          },
          "requestId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "requestId",
          "name"
        ],
        "type": "object"
      },
      "CurrentUser": {
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "isGuest": {
            "type": "boolean"
          },
          "isPlatformAdmin": {
            "type": "boolean"
          },
          "preferences": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "required": [
          "id",
          "displayName",
          "isPlatformAdmin",
          "isGuest",
          "preferences"
        ],
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "ManagedRoom": {
        "additionalProperties": false,
        "properties": {
          "archivedAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "maxCapacity": {
            "type": "integer"
          },
          "memberCount": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "shortCode": {
            "type": "string"
          },
          "state": {
            "enum": [
              "open",
              "closed",
              "locked"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "shortCode",
          "name",
          "state",
          "maxCapacity",
          "memberCount",
          "archivedAt",
          "createdAt"
        ],
        "type": "object"
      },
      "PreferenceRequest": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "value": {}
        },
        "required": [
          "key",
          "value"
        ],
        "type": "object"
      },
      "Preferences": {
        "additionalProperties": true,
        "type": "object"
      },
      "ProfileUpdateRequest": {
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "preferences": {
            "$ref": "#/components/schemas/Preferences"
          }
        },
        "required": [
          "displayName",
          "preferences"
        ],
        "type": "object"
      },
      "Session": {
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "type": "string"
          },
          "expiresAt": {
            "format": "int64",
            "type": "integer"
          },
          "isPlatformAdmin": {
            "type": "boolean"
          },
          "userId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "userId",
          "displayName",
          "isPlatformAdmin",
          "expiresAt"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "accessCookie": {
        "in": "cookie",
        "name": "__Host-tradingroom_access",
        "type": "apiKey"
      },
      "refreshCookie": {
        "in": "cookie",
        "name": "__Host-tradingroom_refresh",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Authoritative authentication, profile, preference, account-bootstrap, and account room-lifecycle contract. This intentionally does not claim to describe the remaining live-room runtime routes. Cookies are issued only through the same-origin SvelteKit boundary.",
    "title": "Trading Room Account Authority API",
    "version": "0.1.0"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "openapi": "3.1.1",
  "paths": {
    "/api/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            },
            "description": "Authenticated; sets access and refresh cookies.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Session family revoked and browser cookies expired.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "refreshCookie": []
          }
        ],
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            },
            "description": "Session rotated; replaces access and refresh cookies.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "refreshCookie": []
          }
        ],
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/v1/account": {
      "get": {
        "operationId": "getAccountBootstrap",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountBootstrap"
                }
              }
            },
            "description": "Current database identity and explicit owner/admin account memberships."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "accessCookie": []
          }
        ],
        "tags": [
          "Account"
        ]
      },
      "patch": {
        "operationId": "updateAccountProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            },
            "description": "Committed canonical profile after the atomic update."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "accessCookie": []
          }
        ],
        "tags": [
          "Account"
        ]
      }
    },
    "/api/v1/account/preferences": {
      "get": {
        "operationId": "getAccountPreferences",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preferences"
                }
              }
            },
            "description": "Current canonical preferences."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "accessCookie": []
          }
        ],
        "tags": [
          "Account"
        ]
      },
      "patch": {
        "operationId": "setAccountPreference",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreferenceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preferences"
                }
              }
            },
            "description": "Preferences after the atomic key update."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "accessCookie": []
          }
        ],
        "tags": [
          "Account"
        ]
      }
    },
    "/api/v1/account/theme": {
      "put": {
        "operationId": "updateAccountTheme",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Preferences"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preferences"
                }
              }
            },
            "description": "Preferences after the shallow theme merge."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "accessCookie": []
          }
        ],
        "tags": [
          "Account"
        ]
      }
    },
    "/api/v1/accounts/{enterprise_id}/rooms": {
      "get": {
        "operationId": "listAccountRooms",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ManagedRoom"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Canonical lifecycle data for every room in an administered account."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "accessCookie": []
          }
        ],
        "tags": [
          "Account"
        ]
      },
      "parameters": [
        {
          "in": "path",
          "name": "enterprise_id",
          "required": true,
          "schema": {
            "format": "uuid",
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "createAccountRoom",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAccountRoomRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagedRoom"
                }
              }
            },
            "description": "The created room, or the original room on an idempotent retry."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "accessCookie": []
          }
        ],
        "tags": [
          "Account"
        ]
      }
    },
    "/api/v1/accounts/{enterprise_id}/rooms/{room_id}": {
      "parameters": [
        {
          "in": "path",
          "name": "enterprise_id",
          "required": true,
          "schema": {
            "format": "uuid",
            "type": "string"
          }
        },
        {
          "in": "path",
          "name": "room_id",
          "required": true,
          "schema": {
            "format": "uuid",
            "type": "string"
          }
        }
      ],
      "patch": {
        "operationId": "setAccountRoomArchived",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArchiveAccountRoomRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagedRoom"
                }
              }
            },
            "description": "Canonical room state after the idempotent archive transition."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "accessCookie": []
          }
        ],
        "tags": [
          "Account"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "Authentication"
    },
    {
      "name": "Account"
    }
  ]
}
