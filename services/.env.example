# Copy this file to services/.env, keep that rendered file untracked, and set
# every blank secret before starting anything. Generate URL-safe database
# passwords (for example with `openssl rand -hex 24`) so the connection strings
# below do not require percent-encoding.

# THREE roles, and the third one is the one the API actually uses.
#
#   POSTGRES_USER        owner / migrator. Runs the migration chain, owns every table.
#   POSTGRES_APP_USER    the BASELINE role. `0001_baseline.sql` names it in 22 RLS policies and
#                        every grant, and re-creates it with a placeholder password if it is
#                        absent — so it must be provisioned properly even though nothing connects
#                        as it. That baseline is byte-identical to the captured schema of the
#                        original system and cannot be edited. See `ops/naming-provenance.md`.
#   POSTGRES_RUNTIME_USER  the RUNTIME role, and what DATABASE_URL must name. Granted parity with
#                        the baseline role by `0009_provision_tradingroom_app.sql`.
#
# Pointing DATABASE_URL at the baseline role instead is not a small mistake: the API's startup
# check (`assert_runtime_role_is_restricted`) compares the authenticated identity against
# `db::migrate::EXPECTED_RUNTIME_ROLE` and refuses to bind. PostgreSQL also reports a nonexistent
# role to the client as `28P01 password authentication failed`, so the error names the wrong cause.
POSTGRES_USER=ptr_clone
POSTGRES_PASSWORD=
POSTGRES_DB=ptr_clone
POSTGRES_PORT=5432
POSTGRES_APP_USER=ptr_clone_app
POSTGRES_APP_PASSWORD=
POSTGRES_RUNTIME_USER=tradingroom_app
POSTGRES_RUNTIME_PASSWORD=

# The owner URL is migration-only. The long-running API receives DATABASE_URL,
# never MIGRATE_DATABASE_URL.
MIGRATE_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL=postgres://${POSTGRES_RUNTIME_USER}:${POSTGRES_RUNTIME_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}

# Each API private key is the standard-Base64 encoding of exactly 32 raw Ed25519
# secret bytes. Generate these independently with `openssl rand -base64 32`.
AUTH_TOKEN_PRIVATE_KEY=
MEDIA_GRANT_PRIVATE_KEY=

# Independent high-entropy service credential shared only with the SvelteKit controller. It
# authenticates the live room's ban, indefinite-mute, and permission writes after membership
# authority cutover. Generate at least 32 non-whitespace ASCII characters; do not reuse another key.
TRADINGROOM_INTERNAL_SECRET=

BIND_ADDRESS=127.0.0.1:8080
DB_POOL_MAX=10
# Integer seconds, inclusive: pool acquisition must be 1..=5 and HTTP
# response construction must be 1..=30.
DB_ACQUIRE_TIMEOUT_SECONDS=5
REQUEST_TIMEOUT_SECONDS=30
TRUSTED_PROXY_HOPS=0
# Exact browser origin, with no trailing slash. The hostname and port must match
# what is in the browser address bar; `localhost` and `127.0.0.1` are different.
TRUSTED_WEB_ORIGIN=http://localhost:5173

# Local SFU defaults. MEDIA_GRANT_PUBLIC_KEY is the padded standard-Base64
# encoding of the 32 raw public bytes corresponding to MEDIA_GRANT_PRIVATE_KEY.
# Loopback bind + loopback announced address is the narrow signed-grant local
# development exception. Any externally bound signed-grant instance requires a
# publicly routable announced address.
MEDIA_BIND_ADDRESS=127.0.0.1:4443
MEDIA_ANNOUNCED_ADDRESS=127.0.0.1
MEDIA_RTC_PORT_MIN=40000
MEDIA_RTC_PORT_MAX=40199
MEDIA_WORKERS=1
MEDIA_GRANT_PUBLIC_KEY=
# Required whenever signed grants are enforced. It will normally be identical
# to TRUSTED_WEB_ORIGIN because both sockets are opened by the same web app.
MEDIA_ALLOWED_ORIGIN=http://localhost:5173

# Leave blank for the fail-closed default. Set exactly `true` only for an
# explicitly anonymous local SFU with MEDIA_GRANT_PUBLIC_KEY left blank. In that
# mode only, MEDIA_ALLOWED_ORIGIN may also be blank to permit non-browser tools;
# both MEDIA_BIND_ADDRESS and MEDIA_ANNOUNCED_ADDRESS must remain loopback.
MEDIA_ALLOW_ANONYMOUS=

RUST_LOG=info,sqlx=warn
