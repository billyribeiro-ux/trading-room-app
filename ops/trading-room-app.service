[Unit]
Description=TradingRoomApp — the room
Documentation=https://github.com/billyribeiro-ux/trading-room-app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradingroomapp
Group=tradingroomapp
WorkingDirectory=/opt/trading-room-app/room
EnvironmentFile=/opt/trading-room-app/room/.env
ExecStart=/usr/bin/node build/index.js
Restart=always
RestartSec=3

# Bound to loopback (HOST=127.0.0.1 in .env); Caddy is the only thing that reaches it, so the
# app itself is never exposed directly and never terminates TLS.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The SQLite file and its WAL sidecars need a writable directory. This is the only one.
ReadWritePaths=/opt/trading-room-app/room/.data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
