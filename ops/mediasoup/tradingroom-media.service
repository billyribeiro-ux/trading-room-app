[Unit]
Description=Trading Room mediasoup service
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/tradingroom-media/media.env
EnvironmentFile=/etc/tradingroom-media/media-image.env
ExecStartPre=-/usr/bin/docker rm -f tradingroom-media
ExecStart=/usr/bin/docker run --name tradingroom-media --network host --env-file /etc/tradingroom-media/media.env --read-only --tmpfs /tmp:rw,noexec,nosuid,nodev,size=64m --cap-drop ALL --security-opt no-new-privileges:true --pids-limit 512 --ulimit nofile=65536:65536 --log-driver json-file --log-opt max-size=10m --log-opt max-file=3 --stop-timeout 30 ${MEDIA_IMAGE}
ExecStop=/usr/bin/docker stop --time 30 tradingroom-media
ExecStopPost=-/usr/bin/docker rm -f tradingroom-media
Restart=always
RestartSec=5
TimeoutStartSec=0
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
