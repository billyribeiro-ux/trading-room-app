+ENV CARGO_BUILD_JOBS=2
 
 WORKDIR /build
 
@@ -50,31 +51,32 @@ WORKDIR /build
 # without any of this crate's own code.
 COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
 COPY media/Cargo.toml ./media/
