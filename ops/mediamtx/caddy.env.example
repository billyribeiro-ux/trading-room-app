# The PUBLIC hostname browsers fetch HLS playlists from. This is the value that must also be set as
# STREAM_SERVER_MTX in the controller's environment — host only, no scheme and no port, because the
# room builds `https://{STREAM_SERVER_MTX}/{path}/index.m3u8?jwt={token}` from it.
MEDIA_STREAM_HOSTNAME=<PUBLIC_STREAM_HOSTNAME>
