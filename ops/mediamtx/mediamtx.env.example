# Rendered OUTSIDE Git and installed at /etc/tradingroom-mediamtx/mediamtx.env (chmod 600, root-owned).
#
# MediaMTX reads its own settings from mediamtx.yml; this file exists for the ONE value the config
# references but must not contain — the hook bearer, expanded by the shell that runs runOnAvailable.

# Must be byte-identical to MEDIA_HOOK_SECRET in the room's .env. Generate with:
#   openssl rand -base64 48
# Deliberately NOT ROOM_JWT_SECRET: that key signs sessions and does not belong on a media box.
MEDIA_HOOK_SECRET=<GENERATED_HOOK_SECRET>
