# The immutable image reference. A DIGEST, never a tag — a tag is mutable and a restart would then
# be able to change what runs without anything in Git changing.
#
# Resolve the digest for the reviewed release and record it here and in the deployment log:
#   docker buildx imagetools inspect bluenviron/mediamtx:<version>
MEDIAMTX_IMAGE=bluenviron/mediamtx@sha256:<RESOLVED_DIGEST>
