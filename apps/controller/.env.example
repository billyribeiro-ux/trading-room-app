# Runtime safety boundary
# marketing-only is the default and serves four static routes, 503ing everything
# else — that is what a deployment with no database should do. postgres enables
# the application and requires DATABASE_URL below.
CONTROL_PLANE_MODE=postgres

# PostgreSQL connection string.
#
# Locally this is an ordinary server:
#   postgres://<user>@localhost:5432/tradingroom_dev
#
# On a serverless host (Vercel) use the provider's POOLED endpoint, not the direct
# one. Each function instance opens its own connection, so the pool that matters is
# the pooler in front of the database; the direct endpoint will exhaust its
# connection limit under load. On Neon that is the host containing `-pooler`.
DATABASE_URL=postgres://localhost:5432/tradingroom_dev

# Private Rust API origin. The browser never calls this host directly; SvelteKit forwards the
# exact account/auth operations and re-issues only reviewed __Host- cookies on this origin.
TRADINGROOM_API_URL=http://127.0.0.1:8080
TRADINGROOM_INTERNAL_SECRET=

# Reversible Gate 3 profile cutover. Keep legacy until the converter's verify phase is green for
# this environment. rust fails startup without the API URL and fails requests on missing/mismatched
# UUID mappings; changing this back to legacy is the rollback switch.
PROFILE_AUTHORITY_MODE=legacy
ROOM_AUTHORITY_MODE=legacy
ROOM_SETTINGS_AUTHORITY_MODE=legacy
MEMBERSHIP_AUTHORITY_MODE=legacy
BADGE_AUTHORITY_MODE=legacy
ADMINISTRATOR_AUTHORITY_MODE=legacy
CUSTOMER_API_KEY_AUTHORITY_MODE=legacy
ROOM_LAUNCH_AUTHORITY_MODE=legacy

# Temporary local seeded-owner login
#
# Username/email: owner@example.com
# Password:       generate a unique local value (12+ characters); never commit it
#
# DEVELOPMENT ONLY. These values are consumed by `node scripts/seed.mjs` when
# creating a new account. They do not change the password of an existing account.
# Replace them before seeding any shared, preview, staging, or production system.
SEED_EMAIL=owner@example.com
SEED_PASSWORD=

# Room launch integration
# Generate independent random values; never reuse secrets between environments.
ROOM_JWT_SECRET=replace-with-at-least-32-bytes-of-random-secret-material
API_KEY_ENCRYPTION_KEY=replace-with-different-random-secret-material
# URL of the separate room application; leave blank until that service is wired.
ROOM_BASE_URL=

# Outbound email. BOTH halves or NEITHER, for the same reason as reCAPTCHA below.
#
# Left blank the product does not send verification mail AND does not enforce it, which is the
# honest state for a deployment with no mailbox. Filling these in turns BOTH on at once: a link is
# sent at registration and room creation is refused until it is clicked.
#
# Before either value is real, the sending domain needs DKIM and SPF records — an address on a
# domain without them is accepted by the provider and dropped by the recipient. There is
# deliberately no example address here, because a plausible one would silently bounce.
RESEND_API_KEY=
MAIL_FROM=

# reCAPTCHA v2. BOTH halves or NEITHER — one without the other is a startup error,
# because a site key alone renders a widget the server never verifies, which looks
# like bot protection and is not. Google publishes an always-pass test pair for local
# use at developers.google.com/recaptcha/docs/faq.
PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Operator console (/admin). Comma-separated emails allowed to see EVERY account.
# Deliberately not a password: a superadmin registers and signs in through the ordinary
# hardened login, and this list grants the extra privilege — so the credential and the
# privilege can be revoked independently. An env var rather than a database column, so
# granting it needs deploy access rather than an INSERT. Blank means nobody, including
# the first account: an empty list fails closed rather than opening a bootstrap backdoor.
SUPERADMIN_EMAILS=

# MediaMTX host that OBS / XSplit publish into. HOST ONLY — no scheme, no port. The two ingest
# URLs append their own: WHIP is http://<host>:8889/<path>/whip, RTMP is rtmp://<host>/<path>.
#
# Blank is an honest, supported state: the room's OBS panel then says the ingest server is not
# configured, rather than showing a presenter a stream link that goes nowhere. It is a DIFFERENT
# host from the SFU — the reference keeps `streamServerMTX` and `streamServer` as two globals, and
# a media ingest tier that shares a box with signalling loses both when either is saturated.
STREAM_SERVER_MTX=
