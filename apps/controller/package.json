{
  "name": "proroom-control",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{svelte,ts,js}\" \"scripts/**/*.mjs\" \"e2e/**/*.ts\" \"*.{js,ts,json,yaml,yml}\"",
    "test": "pnpm run schema:verify && pnpm run backend:migrations:verify && pnpm run backend:release:verify && pnpm run evidence:verify && pnpm run privacy:verify && pnpm run breakpoints:verify && pnpm run manage:styles && pnpm run account:contract && pnpm run home:contract && pnpm run fonts:verify && pnpm run room-login:contract && pnpm run runtime:http && pnpm run test:unit && node scripts/verify-documented-test-counts.mjs --report .vitest-report.json",
    "test:counts": "node scripts/verify-documented-test-counts.mjs",
    "test:unit": "vitest run --coverage --reporter=default --reporter=json --outputFile=.vitest-report.json",
    "test:e2e": "playwright test",
    "audit:js": "pnpm audit --audit-level high",
    "quality": "pnpm run lint && pnpm run format:check && pnpm run check && pnpm run test && pnpm run test:e2e && pnpm run build",
    "evidence:verify": "node scripts/verify-evidence-layout.mjs",
    "breakpoints:verify": "node scripts/verify-breakpoints.mjs",
    "account:contract": "node scripts/verify-account-contract.mjs",
    "account:http": "node scripts/verify/api-key-http.mjs",
    "account:tooltips": "node scripts/verify-navbar-tooltips.mjs",
    "account:responsive": "node scripts/verify/verify-account-responsive.mjs",
    "account:forensics": "node scripts/verify/verify-account.mjs && node scripts/verify/verify-account-full.mjs && node scripts/verify/verify-account-responsive.mjs && node scripts/verify/hover-truth.mjs && node scripts/verify/audit-all.mjs && node scripts/verify/btn-diff.mjs && node scripts/verify/verify-behaviour.mjs && node scripts/verify/verify-intro.mjs",
    "home:contract": "node scripts/verify-home-contract.mjs",
    "fonts:verify": "node scripts/verify-font-contract.mjs",
    "room-login:contract": "node scripts/verify-room-login-contract.mjs",
    "runtime:http": "node scripts/verify-public-preview-http.mjs",
    "privacy:redact": "node scripts/redact-owner-evidence.mjs",
    "privacy:verify": "node scripts/verify-privacy-boundary.mjs",
    "schema:extract": "node scripts/extract-manage-schema.mjs",
    "schema:verify": "node scripts/verify-room-settings-schema.mjs",
    "backend:migrations:verify": "node scripts/verify-backend.mjs --migrations-only && node scripts/verify-backend-provenance.mjs",
    "backend:check": "node scripts/verify-backend.mjs",
    "backend:provenance:verify": "node scripts/verify-backend-provenance.mjs",
    "backend:advisories": "node scripts/verify-rust-advisories.mjs",
    "backend:postgres:attest": "cargo run --locked --manifest-path services/Cargo.toml -p tradingroom-api --bin postgres-release-attestation --",
    "backend:release:verify": "node scripts/verify-api-release-artifact.mjs --verify-contract",
    "backend:licenses": "cargo deny --manifest-path services/Cargo.toml --locked --all-features check licenses bans sources",
    "test:db": "vitest run --config vitest.db.config.ts",
    "manage:styles": "node scripts/verify-manage-styles.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "5.8.1",
    "@threlte/core": "8.5.16",
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "drizzle-orm": "0.45.2",
    "font-awesome": "4.3.0",
    "gsap": "3.15.0",
    "postgres": "3.4.9",
    "three": "0.185.1",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@sveltejs/adapter-vercel": "7.0.0-next.6",
    "@sveltejs/kit": "3.0.0-next.16",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/d3-array": "3.2.2",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.1.8",
    "@types/three": "0.185.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.22.0",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.8",
    "svelte-check": "4.7.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
