{
  // Kit 3 generates this at `node_modules/$app/tsconfig.json` and it is the supported base:
  // it carries `types: ["$app/types"]` and the `rootDirs` that make `./$types` imports resolve.
  //
  // Kit 2's base lived at `./.svelte-kit/tsconfig.json` and additionally supplied an `include`.
  // Kit 3's does NOT, so the include has to be stated here — without it TypeScript falls back to
  // "everything under the project directory", which drags `scripts/**` into the check and produced
  // 1238 errors that were entirely an artefact of the missing list.
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true
    // NO `paths` BLOCK, removed 2026-08-16 with the `$lib` specifiers it existed for.
    //
    // It used to carry `$lib` and `$lib/*` under a comment saying "Kit 3's base ships `paths: {}`
    // where Kit 2's supplied these". That was false for this version — the generated base ships
    // `$lib` paths of its own — so the block was a redundant copy, and because `extends` REPLACES
    // `paths` rather than merging it, ours overwrote the generated one. In the room, `vite build`
    // said so outright once `#lib` specifiers existed: `"paths" was overwritten. Imports from
    // "#lib" may not typecheck`.
    //
    // `#lib` resolves through the `imports` field in `package.json` instead, which TypeScript reads
    // natively under `moduleResolution: "bundler"` and Vite resolves without a plugin — that being
    // the reason SvelteKit 3 dropped the alias at all.
    //
    // `esModuleInterop` also went: the generated base already sets it.
  },
  // Mirrors what Kit 2's generated base included: application source and the Vite config, and
  // nothing else. `scripts/**` is tooling and `e2e/**` is Playwright — neither was type-checked
  // before, and pulling them in now would be a new gate wearing the disguise of a config change.
  "include": ["src/**/*.js", "src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
