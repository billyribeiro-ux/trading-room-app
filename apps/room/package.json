{
  "name": "proroom-staff-reconstruction",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "start:local": "ORIGIN=http://localhost:${PORT:-3000} node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "verify:tooltips": "node --no-warnings scripts/verify-tooltip-placements.mjs",
    "verify:screen-volume": "node --no-warnings scripts/verify-screen-volume.mjs",
    "verify:viewer-only": "node --no-warnings scripts/verify-viewer-only-layout.mjs",
    "verify:mobile-layout": "node --no-warnings scripts/verify-mobile-layout.mjs",
    "capture:analyze": "node scripts/analyze-capture.mjs",
    "capture:forensic": "node scripts/forensic-audit.mjs",
    "capture:emoji": "node scripts/render-emoji-state.mjs",
    "capture:emoji-computed": "node scripts/audit-emoji-computed.mjs",
    "capture:emoji-behaviour": "node scripts/audit-emoji-behaviour.mjs",
    "capture:behaviors": "node scripts/audit-behavior-coverage.mjs",
    "capture:file-upload": "node scripts/verify-file-upload-state.mjs",
    "capture:direct": "node scripts/audit-direct-evidence.mjs",
    "capture:components": "node scripts/audit-production-components.mjs",
    "capture:decode-components": "node scripts/extract-all-production-components.mjs",
    "capture:states": "node scripts/render-emoji-state.mjs && node scripts/compare-capture-states.mjs proroom-ULTIMATE-staff-2026-07-24T12-42-02-part1.json --url=http://127.0.0.1:5175/ --emoji-html=/private/tmp/ptr-emoji-ssr.html",
    "capture:media": "node scripts/audit-media-contract.mjs",
    "capture:styles": "node scripts/audit-style-coverage.mjs",
    "capture:styles-complete": "node scripts/audit-complete-stylesheet.mjs",
    "css:sync-captured": "node scripts/build-captured-runtime-styles.mjs",
    "capture:messages-sync": "node scripts/build-captured-message-fixture.mjs",
    "capture:navbar": "node scripts/audit-clean-navbar.mjs",
    "capture:navbar-source": "node scripts/audit-navbar-source-contract.mjs",
    "capture:navbar-computed": "node scripts/audit-navbar-computed.mjs",
    "capture:navbar-interactions": "node scripts/audit-navbar-interactions.mjs",
    "capture:alert-chat-styles": "node scripts/audit-alert-chat-style-contract.mjs",
    "capture:dnd-source": "node scripts/audit-dnd-source-contract.mjs",
    "capture:room-clean": "node scripts/audit-clean-app-room.mjs",
    "audit:forms": "node scripts/audit-svelte-form-fields.mjs",
    "audit:forms:rendered": "node scripts/audit-rendered-form-fields.mjs",
    "audit:messages:rendered": "node scripts/audit-rendered-messages.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "schema:verify": "node scripts/verify-postgres-schema-artifacts.mjs",
    "test": "pnpm privacy:verify && pnpm schema:verify && vitest run",
    "privacy:verify": "node scripts/verify-privacy-boundary.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "5.8.1",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-link": "3.29.2",
    "@tiptap/extension-table": "3.29.2",
    "@tiptap/extension-text-align": "3.29.2",
    "@tiptap/extension-text-style": "3.29.2",
    "@tiptap/extension-underline": "3.29.2",
    "@tiptap/extension-youtube": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "animate.css": "3.7.2",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "hls.js": "^1.7.0",
    "howler": "2.2.4",
    "mediasoup-client": "^3.21.0",
    "sanitize-html": "2.17.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.0-next.8",
    "@sveltejs/adapter-vercel": "7.0.0-next.6",
    "@sveltejs/kit": "3.0.0-next.16",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/howler": "2.2.13",
    "@types/node": "26.2.0",
    "@types/sanitize-html": "2.16.1",
    "drizzle-kit": "0.31.10",
    "jsdom": "^30.0.1",
    "parse5": "^8.0.1",
    "postcss": "^8.5.25",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.8",
    "svelte-check": "4.7.5",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
