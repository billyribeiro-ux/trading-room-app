{
  "name": "proroom-staff-reconstruction",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "start:local": "ORIGIN=http://localhost:${PORT:-3000} node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "schema:verify": "node gate/verify-postgres-schema-artifacts.mjs",
    "test": "pnpm privacy:verify && pnpm schema:verify && vitest run",
    "privacy:verify": "node gate/verify-privacy-boundary.mjs",
    "lint": "eslint .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "5.8.1",
    "@tiptap/core": "3.30.3",
    "@tiptap/extension-image": "3.30.3",
    "@tiptap/extension-link": "3.30.3",
    "@tiptap/extension-table": "3.30.3",
    "@tiptap/extension-text-align": "3.30.3",
    "@tiptap/extension-text-style": "3.30.3",
    "@tiptap/extension-underline": "3.30.3",
    "@tiptap/extension-youtube": "3.30.3",
    "@tiptap/starter-kit": "3.30.3",
    "animate.css": "3.7.2",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "hls.js": "^1.7.1",
    "howler": "2.2.4",
    "mediasoup-client": "^3.22.0",
    "sanitize-html": "2.17.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-node": "6.0.0-next.10",
    "@sveltejs/adapter-vercel": "7.0.0-next.8",
    "@sveltejs/kit": "3.0.0-next.25",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/howler": "2.2.13",
    "@types/node": "26.3.0",
    "@types/sanitize-html": "2.16.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.11.0",
    "jsdom": "^30.0.1",
    "parse5": "^8.0.1",
    "postcss": "^8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "@playwright/test": "1.62.1"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
