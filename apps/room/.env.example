DATABASE_URL=.data/proroom.sqlite
PUBLIC_PTR_UPLOAD_SERVER=
PUBLIC_PTR_CDN_UPLOAD_KEY=
PUBLIC_PTR_GIPHY_API_KEY=

# --- media (SFU admission) ---------------------------------------------------
# Ed25519 PKCS#8 PEM. SERVER ONLY - this is the half that mints grants, and it must
# never be given a PUBLIC_ prefix. Generate a pair with:
#   node -e "const {generateKeyPairSync,createPublicKey}=require('node:crypto');
#   const {privateKey}=generateKeyPairSync('ed25519');
#   console.log(privateKey.export({format:'pem',type:'pkcs8'}).toString());
#   const {x}=createPublicKey(privateKey).export({format:'jwk'});
#   console.log('MEDIA_GRANT_PUBLIC_KEY=' + Buffer.from(x,'base64url').toString('base64'))"
# The printed MEDIA_GRANT_PUBLIC_KEY goes to the media service (services/media), which
# holds only the public half and can verify a grant but not mint one. If the two halves
# come from different pairs every peer is refused with no other symptom.
MEDIA_GRANT_PRIVATE_KEY=

# MEDIA_ROOM_ID is gone. It was a deployment constant ('ptr-room') because the app had no room
# entity to derive one from; it now does, and the grant carries `tra-<shortCode>` for the room the
# session was actually handed into. A single constant meant every room on the deployment shared one
# SFU room, so two unrelated rooms saw and heard each other.

# The SFU's signalling socket, returned to the browser by /api/media/grant.
# Defaults to ws://localhost:4443/ws, matching services/media's own MEDIA_BIND_ADDRESS
# default and its /ws route. Use wss:// anywhere real - the grant rides the query string.
MEDIA_WS_URL=

# The controller that owns this room's configuration, and the shared secret it signs with.
#
# The room fetches its settings, its lock list and the connected member's per-room standing from
# `<CONTROL_BASE_URL>/internal/room-config/<shortCode>` on every page load, and fails CLOSED if it
# cannot: serving default settings under the impression they are the owner's is worse than an
# error. So a wrong value here is not a degraded room, it is a 500 on Launch.
#
# 5173 is the controller's own declared port (its `vite.config.ts`, strictPort), and this room
# declares 5174 for the same reason. Both `.env` files previously named ports neither application
# served — 5180 here, and whatever Vite defaulted to there — which is exactly the failure above.
CONTROL_BASE_URL=http://localhost:5173
ROOM_JWT_SECRET=
